{% extends 'base.html.twig' %}

{% block title %}Gestion du Catalogue — Admin{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Gestion du Catalogue</h1>
            <a href="{{ path('app_admin_plant_search') }}" class="btn btn-primary">+ Importer via API</a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        <table class="table table-striped align-middle">
            <thead>
            <tr>
                <th>Image</th>
                <th>Nom</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for plante in plantes %}
                <tr>
                    <td>
                        <img src="{{ plante.image }}" alt="{{ plante.nom }}" style="width: 50px; height: 50px; object-fit: cover;" onerror="this.src='{{ asset('notfound.png') }}';">
                    </td>
                    <td><strong>{{ plante.nom }}</strong></td>
                    <td>{{ plante.description|slice(0, 80) }}...</td>
                    <td>
                        <div class="d-flex gap-2">
                            <a href="{{ path('app_admin_plante_edit', {id: plante.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                            <form method="post" action="{{ path('app_admin_plante_delete', {id: plante.id}) }}" onsubmit="return confirm('Supprimer définitivement cette plante du catalogue ?');">
                                <button class="btn btn-sm btn-danger">Supprimer</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4">Aucune plante au catalogue.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Mes Plantes — Plantasia{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="font-heading display-4 mb-4">Mon Jardin</h1>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success border-0 shadow-sm mb-4">{{ message }}</div>
        {% endfor %}

        <h2 class="font-heading h3 mb-3 text-muted">Mes plantes à la maison</h2>
        <div class="row">
            {% for item in mesPlantes %}
                <div class="col-md-4 mb-4">
                    <div class="card card-plantasia card-clickable h-100 position-relative">
                        <div class="card-img-wrapper">
                            <img src="{{ item.plante.image }}" class="card-img-top" alt="{{ item.plante.nom }}" style="height: 220px; object-fit: cover;" onerror="this.src='{{ asset('notfound.png') }}';">
                        </div>
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <h5 class="card-title mb-0 font-heading fs-3">
                                            <a href="{{ path('app_user_plante_show', {id: item.id}) }}" class="stretched-link text-decoration-none text-reset">
                                                {{ item.surnom ?: item.plante.nom }}
                                            </a>
                                        </h5>
                                        <p class="text-muted small mb-0">
                                            {{ item.plante.nom }}
                                            {% if item.emplacement is defined and item.emplacement %}
                                                &bull; <i class="fa-solid fa-map-pin"></i> {{ item.emplacement }}
                                            {% endif %}
                                        </p>
                                    </div>
                                    {% if item.joursRestants is not null %}
                                        {% if item.joursRestants > 1 %}
                                            <span class="badge badge-water badge-water-ok"><i class="fa-solid fa-droplet"></i> J-{{ item.joursRestants }}</span>
                                        {% elseif item.joursRestants == 1 %}
                                            <span class="badge badge-water badge-water-warning"><i class="fa-solid fa-droplet"></i> Demain !</span>
                                        {% elseif item.joursRestants == 0 %}
                                            <span class="badge badge-water badge-water-warning"><i class="fa-solid fa-droplet"></i> Aujourd'hui !</span>
                                        {% else %}
                                            <span class="badge badge-water badge-water-danger"><i class="fa-solid fa-droplet"></i> Retard ({{ item.joursRestants|abs }}j)</span>
                                        {% endif %}
                                    {% elseif item.frequenceArrosage is null %}
                                        <span class="badge bg-light text-muted border">À définir</span>
                                    {% endif %}
                                </div>

                                <p class="card-text text-secondary small mt-3">{{ item.plante.description|slice(0, 70) }}...</p>
                            </div>

                            <div>
                                <p class="text-muted small border-top pt-2 mb-3">
                                    Dernier arrosage :
                                    <strong>{{ item.dernierArrosage ? item.dernierArrosage|date('d/m/Y') : 'Jamais' }}</strong>
                                </p>

                                <div class="d-flex justify-content-end align-items-center gap-1 position-relative" style="z-index: 2;">
                                    <form method="post" action="{{ path('app_user_plante_water', {id: item.id}) }}">
                                        <button class="btn btn-sm btn-light border" title="Arroser"><i class="fa-solid fa-droplet"></i></button>
                                    </form>
                                    <form method="post" action="{{ path('app_user_plante_delete', {id: item.id}) }}" onsubmit="return confirm('Retirer cette plante ?');">
                                        <button class="btn btn-sm btn-light border text-danger" title="Retirer"><i class="fa-solid fa-trash"></i></button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <p class="text-muted italic">Vous n'avez pas encore de plantes dans votre collection.</p>
                </div>
            {% endfor %}
        </div>

        <div class="d-flex justify-content-between align-items-center mt-5 mb-4 pb-2 border-bottom">
            <h2 class="font-heading h3 mb-0">Catalogue des plantes disponibles</h2>
            <form method="get" action="{{ path('app_user_plante_index') }}" class="d-flex gap-2">
                <input type="text"
                       name="q"
                       value="{{ search }}"
                       class="form-control form-control-sm border-0 bg-white shadow-sm"
                       placeholder="Rechercher une plante..."
                       style="width: 250px;">
                <button type="submit" class="btn btn-sm btn-plantasia-primary">Rechercher</button>
                {% if search is not empty %}
                    <a href="{{ path('app_user_plante_index') }}" class="btn btn-sm btn-light border">Effacer</a>
                {% endif %}
            </form>
        </div>

        <div class="row">
            {% for plante in catalogue %}
                <div class="col-md-3 mb-4">
                    <div class="card card-plantasia h-100">
                        <div class="card-img-wrapper">
                            <img src="{{ plante.image }}" class="card-img-top" alt="{{ plante.nom }}" style="height: 160px; object-fit: cover;" onerror="this.src='{{ asset('notfound.png') }}';">
                        </div>
                        <div class="card-body d-flex flex-column justify-content-between p-3">
                            <h6 class="font-heading fs-4 mb-2">{{ plante.nom }}</h6>
                            <form method="post" action="{{ path('app_user_plante_add', {id: plante.id}) }}">
                                <button class="btn btn-plantasia-outline w-100 btn-sm">Ajouter au jardin</button>
                            </form>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Inscription — Plantasia{% endblock %}

{% block body %}
    <div class="container d-flex justify-content-center align-items-center" style="min-height: 70vh;">
        <div class="card card-plantasia p-4 p-md-5" style="width: 100%; max-width: 450px;">
            <h1 class="font-heading display-5 text-center mb-1">Créer un compte</h1>
            <p class="text-muted text-center small mb-4">Rejoignez Plantasia et suivez votre jardin</p>

            {% for flash_error in app.flashes('verify_email_error') %}
                <div class="alert alert-danger border-0 small mb-3" role="alert">{{ flash_error }}</div>
            {% endfor %}

            {{ form_errors(registrationForm) }}

            {{ form_start(registrationForm) }}
            <div class="mb-3">
                {{ form_row(registrationForm.email, {
                    'attr': {'class': 'form-control', 'placeholder': 'nom@exemple.fr'},
                    'label_attr': {'class': 'form-label small fw-bold'}
                }) }}
            </div>

            <div class="mb-3">
                {{ form_row(registrationForm.plainPassword, {
                    'label': 'Mot de passe',
                    'attr': {'class': 'form-control', 'placeholder': '••••••••'},
                    'label_attr': {'class': 'form-label small fw-bold'}
                }) }}
            </div>

            <div class="mb-4 form-check">
                {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'form-check-input'}}) }}
                {{ form_label(registrationForm.agreeTerms, 'J\'accepte les conditions d\'utilisation', {'label_attr': {'class': 'form-check-label small text-muted'}}) }}
            </div>

            <button type="submit" class="btn btn-plantasia-primary w-100 py-2 mb-3">S'inscrire</button>

            <p class="text-center small text-muted mb-0">
                Déjà un compte ? <a href="{{ path('app_login') }}" class="text-success fw-bold text-decoration-none">Se connecter</a>
            </p>
            {{ form_end(registrationForm) }}
        </div>
    </div>
{% endblock %}
